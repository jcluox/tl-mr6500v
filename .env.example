# Router login password (required)
TPLINK_PASSWORD=your_password_here

# Dashboard login (required; use a different password from the router's)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Days a Dashboard login stays valid; each use renews it
SESSION_DAYS=30

# Most recent messages to import (first start and the Dashboard import button); 0 = all
IMPORT_LIMIT=20

# Router address (default http://192.168.1.1)
ROUTER_HOST=http://192.168.1.1

# Initial seconds between checks for new messages; change it later on the Dashboard Settings tab
POLL_INTERVAL_SECONDS=30

# Enabled providers, comma-separated; you can enable several: telegram,line
ENABLED_PROVIDERS=telegram

# Telegram: get the token from @BotFather; chat ids can be comma-separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# LINE Messaging API: channel access token and the user ids that receive messages (comma-separated)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_IDS=

# Source networks treated as "this machine" (comma-separated). The default is fine
# when running directly on this machine. With Docker, requests may come from the bridge gateway instead.
# LOCAL_CLIENT_CIDRS=127.0.0.0/8,::1/128

# Where state and error logs are stored (./data and ./logs are mounted in Docker)
DATA_DIR=./data
LOG_DIR=./logs
